# ── Shared secrets ────────────────────────────────────────────────────────────
JWT_SECRET=lab3-demo-secret

# ── Kafka UI (exposed for debugging) ──────────────────────────────────────────
KAFKA_UI_PORT=8088

# ── MinIO (console exposed for debugging; API exposed for presigned URLs) ─────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_BUCKET_NAME=claim-attachments
STORAGE_VERIFY_MINIO_OBJECT=false

# ── Database credentials ───────────────────────────────────────────────────────
# DB hosts/ports are resolved internally by docker-compose (postgres-* services).
# Override only the credentials if needed.
AUTH_DB_NAME=blps_auth
AUTH_DB_USERNAME=blps_auth_user
AUTH_DB_PASSWORD=blps_auth_password

CLAIM_DB_NAME=blps_claim
CLAIM_DB_USERNAME=blps_claim_user
CLAIM_DB_PASSWORD=blps_claim_password

ASSESSMENT_DB_NAME=blps_assessment
ASSESSMENT_DB_USERNAME=blps_assessment_user
ASSESSMENT_DB_PASSWORD=blps_assessment_password

PENALTY_DB_NAME=blps_penalty
PENALTY_DB_USERNAME=blps_penalty_user
PENALTY_DB_PASSWORD=blps_penalty_password

NOTIFICATION_DB_NAME=blps_notification
NOTIFICATION_DB_USERNAME=blps_notification_user
NOTIFICATION_DB_PASSWORD=blps_notification_password

AUDIT_DB_NAME=blps_audit
AUDIT_DB_USERNAME=blps_audit_user
AUDIT_DB_PASSWORD=blps_audit_password

STORAGE_DB_NAME=blps_storage
STORAGE_DB_USERNAME=blps_storage_user
STORAGE_DB_PASSWORD=blps_storage_password

# ── Local dev overrides (only needed when running services via bootRun) ────────
# Uncomment and adjust if you want to run services locally against dockerized infra:
#
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# AUTH_DB_HOST=localhost
# AUTH_DB_PORT=5433
# CLAIM_DB_HOST=localhost
# CLAIM_DB_PORT=5434
# ASSESSMENT_DB_HOST=localhost
# ASSESSMENT_DB_PORT=5435
# PENALTY_DB_HOST=localhost
# PENALTY_DB_PORT=5436
# NOTIFICATION_DB_HOST=localhost
# NOTIFICATION_DB_PORT=5437
# AUDIT_DB_HOST=localhost
# AUDIT_DB_PORT=5438
# STORAGE_DB_HOST=localhost
# STORAGE_DB_PORT=5439
#
# AUTH_GRPC_TARGET=localhost:19082
# CLAIM_GRPC_TARGET=localhost:19081
# PENALTY_GRPC_TARGET=localhost:19084
# AUDIT_GRPC_TARGET=localhost:19086
# STORAGE_GRPC_TARGET=localhost:19087
# NOTIFICATION_GRPC_TARGET=localhost:19085
# NOTIFICATION_GRPC_PORT=19085
# MINIO_PUBLIC_URL=http://localhost:9000
