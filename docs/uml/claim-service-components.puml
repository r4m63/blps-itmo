@startuml
title claim-service - Component Diagram

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

package "claim-service" {
  [ClaimController] as Controller
  [ClaimGrpcService] as GrpcService
  [ClaimProcessService] as Service
  [ClaimEventListeners] as Listeners
  [AuthClient gRPC stub] as AuthClient
  [ClaimRepository] as ClaimRepo
  [ClaimTimelineRepository] as TimelineRepo
  [OutboxService] as OutboxService
  [ProcessedMessageService] as InboxService
  [OutboxRelay] as Relay
}

database "claim-db" as ClaimDB
queue "Kafka" as Kafka
component "auth-service" as AuthService

Controller --> Service : debug HTTP command handling
GrpcService --> Service : gRPC command/query handling
Listeners --> Service : event handling
Service --> AuthClient : validate users
AuthClient --> AuthService : AuthRpcService.GetUser

Service --> ClaimRepo
Service --> TimelineRepo
Service --> OutboxService
Service --> InboxService

ClaimRepo --> ClaimDB
TimelineRepo --> ClaimDB
OutboxService --> ClaimDB : write outbox_events
InboxService --> ClaimDB : read/write processed_messages
Relay --> ClaimDB : poll outbox_events
Relay --> Kafka : publish EventEnvelope

Listeners --> Kafka : consume events

@enduml
