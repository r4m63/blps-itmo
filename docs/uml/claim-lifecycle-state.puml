@startuml
title Claim Lifecycle State Machine

skinparam shadowing false

[*] --> ASSESSMENT_IN_PROGRESS : createClaim

ASSESSMENT_IN_PROGRESS --> NEED_ADDITIONAL_INFO : ASSESSMENT_COMPLETED\nrequiresAdditionalInfo=true
ASSESSMENT_IN_PROGRESS --> AWAITING_TENANT_RESPONSE : ASSESSMENT_COMPLETED\npenaltyGrounds=true
ASSESSMENT_IN_PROGRESS --> CLOSED_NO_PENALTY : ASSESSMENT_COMPLETED\npenaltyGrounds=false

NEED_ADDITIONAL_INFO --> ASSESSMENT_IN_PROGRESS : additional-info
AWAITING_TENANT_RESPONSE --> SUPPORT_REVIEW : tenant-response

SUPPORT_REVIEW --> CLOSED_NO_PENALTY : support-decision\napplyPenalty=false
SUPPORT_REVIEW --> PENALTY_PROCESSING : support-decision\napplyPenalty=true

PENALTY_PROCESSING --> PENALTY_APPLIED : PENALTY_APPLIED
PENALTY_PROCESSING --> PENALTY_PROCESSING_FAILED : PENALTY_APPLICATION_FAILED
PENALTY_PROCESSING_FAILED --> PENALTY_APPLIED : manual retry + PENALTY_APPLIED

ASSESSMENT_IN_PROGRESS --> CLOSED_NO_PENALTY : USER_DEACTIVATED
NEED_ADDITIONAL_INFO --> CLOSED_NO_PENALTY : USER_DEACTIVATED
AWAITING_TENANT_RESPONSE --> CLOSED_NO_PENALTY : USER_DEACTIVATED
SUPPORT_REVIEW --> CLOSED_NO_PENALTY : USER_DEACTIVATED
PENALTY_PROCESSING --> CLOSED_NO_PENALTY : USER_DEACTIVATED
PENALTY_PROCESSING_FAILED --> CLOSED_NO_PENALTY : USER_DEACTIVATED

CLOSED_NO_PENALTY --> [*]
PENALTY_APPLIED --> [*]

@enduml
