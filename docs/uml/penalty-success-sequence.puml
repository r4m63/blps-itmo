@startuml
title Penalty Success Saga

autonumber
skinparam shadowing false

actor Admin
participant "claim-service" as Claim
database "claim-db" as ClaimDB
queue "Kafka" as Kafka
participant "penalty-service" as Penalty
database "penalty-db" as PenaltyDB
participant "auth-service" as Auth
database "auth-db" as AuthDB
participant "audit-service" as Audit

Admin -> Claim : POST /api/claims/{id}/support-decision\napplyPenalty=true
Claim -> ClaimDB : UPDATE claim=PENALTY_PROCESSING\nINSERT timeline\nINSERT outbox(PENALTY_APPLICATION_REQUESTED)
Claim --> Admin : ClaimResponse(status=PENALTY_PROCESSING)
Claim -> Kafka : publish PENALTY_APPLICATION_REQUESTED\n(via outbox relay)

Kafka -> Penalty : PENALTY_APPLICATION_REQUESTED
Penalty -> PenaltyDB : INSERT penalty_operation=PENDING\nINSERT processed_message

... asynchronous worker delay ...

Penalty -> PenaltyDB : UPDATE penalty_operation=APPLIED\nINSERT outbox(PENALTY_APPLIED)
Penalty -> Kafka : publish PENALTY_APPLIED\n(via outbox relay)

Kafka -> Claim : PENALTY_APPLIED
Claim -> ClaimDB : UPDATE claim=PENALTY_APPLIED\nINSERT timeline\nINSERT processed_message

Kafka -> Auth : PENALTY_APPLIED
Auth -> AuthDB : UPDATE users.penalty_count = penalty_count + 1\nINSERT processed_message

Kafka -> Audit : PENALTY_APPLIED

note right of Claim
  Claim reaches final status
  only after async penalty result
end note

@enduml
