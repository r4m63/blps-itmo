@startuml
title User Deactivation Saga

autonumber
skinparam shadowing false

actor Admin
participant "auth-service" as Auth
database "auth-db" as AuthDB
queue "Kafka" as Kafka
participant "claim-service" as Claim
database "claim-db" as ClaimDB
participant "audit-service" as Audit
participant "notification-service" as Notification

Admin -> Auth : POST /api/auth/users/{id}/deactivate
Auth -> AuthDB : UPDATE users.enabled=false\nINSERT outbox(USER_DEACTIVATED)
Auth --> Admin : RemoteUserView(enabled=false)
Auth -> Kafka : publish USER_DEACTIVATED

Kafka -> Claim : USER_DEACTIVATED
Claim -> ClaimDB : FIND open claims by landlordId/tenantId
Claim -> ClaimDB : UPDATE each open claim to CLOSED_NO_PENALTY\nINSERT timeline\nINSERT processed_message

Kafka -> Audit : USER_DEACTIVATED
Kafka -> Notification : USER_DEACTIVATED

note right of Claim
  Cross-service consistency is achieved
  asynchronously after user deactivation
end note

@enduml
