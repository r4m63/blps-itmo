@baseUrl = http://localhost:21001
@landlord1Id = 1
@landlord2Id = 2
@tenant1Id = 4
@tenant2Id = 5
@admin1Id = 7
@admin2Id = 8
@landlord1Basic = bGFuZGxvcmQxQGV4YW1wbGUuY29tOnBhc3N3b3Jk
@landlord2Basic = bGFuZGxvcmQyQGV4YW1wbGUuY29tOnBhc3N3b3Jk
@tenant1Basic = dGVuYW50MUBleGFtcGxlLmNvbTpwYXNzd29yZA==
@tenant2Basic = dGVuYW50MkBleGFtcGxlLmNvbTpwYXNzd29yZA==
@admin1Basic = YWRtaW4xQGV4YW1wbGUuY29tOnBhc3N3b3Jk
@admin2Basic = YWRtaW4yQGV4YW1wbGUuY29tOnBhc3N3b3Jk

### Учётные записи:
### - landlord1@example.com / password
### - landlord2@example.com / password
### - tenant1@example.com / password
### - tenant2@example.com / password
### - admin1@example.com / password
### - admin2@example.com / password
### Файл загружается из `../test-resources/image.png`

###############################################################################
### 0. RBAC smoke checks
###############################################################################

### Без авторизации: ожидаем 401 Unauthorized
GET {{baseUrl}}/api/claims/1

### Tenant не может создать заявку: ожидаем 403 Forbidden
POST {{baseUrl}}/api/claims
Authorization: Basic {{tenant1Basic}}
Content-Type: application/json

{
  "tenantId": {{tenant1Id}},
  "title": "Forbidden create attempt",
  "description": "Tenant must not be allowed to create claims",
  "claimedAmount": 1.00,
  "currency": "USD"
}

### Smoke для /api/storage/presign
# @name presignSmoke
POST {{baseUrl}}/api/storage/presign
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "fileName": "presign-smoke.png",
  "contentType": "image/png"
}

###############################################################################
### 1. Happy path: доп. материалы -> оценка -> ответ арендатора -> штраф
###############################################################################

### 1.1 LANDLORD: инициализация основного вложения
# @name landlordEvidenceInit
POST {{baseUrl}}/api/storage/attachments/init
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "fileName": "damage-evidence.png",
  "contentType": "image/png",
  "purpose": "DAMAGE_EVIDENCE"
}

### 1.2 LANDLORD: загрузка файла в MinIO по presigned URL
PUT {{landlordEvidenceInit.response.body.$.uploadUrl}}
Content-Type: image/png

< ../test-resources/image.png

### 1.3 LANDLORD: подтверждение загрузки вложения
# @name landlordEvidenceConfirm
POST {{baseUrl}}/api/storage/attachments/confirm
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "objectKey": "{{landlordEvidenceInit.response.body.$.objectKey}}"
}

### 1.4 LANDLORD: создание заявки с вложением
# @name createPenaltyClaim
POST {{baseUrl}}/api/claims
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "tenantId": {{tenant1Id}},
  "title": "Разбитое окно и повреждена рама",
  "description": "После выезда гостя обнаружено повреждение окна и следы удара по раме.",
  "claimedAmount": 500.00,
  "currency": "USD",
  "attachmentKeys": [
    "{{landlordEvidenceConfirm.response.body.$.objectKey}}"
  ]
}

### 1.5 LANDLORD: просмотр своей заявки
GET {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}
Authorization: Basic {{landlord1Basic}}

### 1.6 LANDLORD: список своих заявок
GET {{baseUrl}}/api/claims/landlord/{{landlord1Id}}?openOnly=true
Authorization: Basic {{landlord1Basic}}

### 1.7 ADMIN: просмотр любой заявки
GET {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}
Authorization: Basic {{admin1Basic}}

### 1.8 ADMIN: первичная проверка - запросить дополнительные материалы
# @name intakeNeedMoreInfo
POST {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/intake
Authorization: Basic {{admin1Basic}}
Content-Type: application/json

{
  "needMoreInfo": true,
  "comment": "Нужны дополнительные фотографии и пояснение по времени обнаружения ущерба."
}

### 1.9 LANDLORD: инициализация дополнительного вложения
# @name landlordAdditionalInit
POST {{baseUrl}}/api/storage/attachments/init
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "fileName": "additional-proof.png",
  "contentType": "image/png",
  "purpose": "ADDITIONAL_MATERIAL"
}

### 1.10 LANDLORD: загрузка дополнительного файла
PUT {{landlordAdditionalInit.response.body.$.uploadUrl}}
Content-Type: image/png

< ../test-resources/image.png

### 1.11 LANDLORD: подтверждение доп. вложения
# @name landlordAdditionalConfirm
POST {{baseUrl}}/api/storage/attachments/confirm
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "objectKey": "{{landlordAdditionalInit.response.body.$.objectKey}}"
}

### 1.12 LANDLORD: ответ на запрос дополнительных материалов
# @name landlordAdditionalReply
POST {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/additional-info
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "comment": "Прикладываю дополнительные фото и пояснение: повреждение обнаружено сразу после уборки.",
  "attachmentIds": [
    {{landlordAdditionalConfirm.response.body.$.attachmentId}}
  ]
}

### 1.13 LANDLORD: получить вложения, присланные как additional info
GET {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/attachments/additional
Authorization: Basic {{landlord1Basic}}

### 1.14 ADMIN: оценка ущерба, есть основания для штрафа
# @name assessPenaltyClaim
POST {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/assessment
Authorization: Basic {{admin1Basic}}
Content-Type: application/json

{
  "assessmentAmount": 420.00,
  "assessmentNotes": "Подтверждено повреждение, сумма пересчитана по акту.",
  "penaltyGrounds": true
}

### 1.15 TENANT: инициализация вложения с возражением
# @name tenantResponseInit
POST {{baseUrl}}/api/storage/attachments/init
Authorization: Basic {{tenant1Basic}}
Content-Type: application/json

{
  "fileName": "tenant-response.png",
  "contentType": "image/png",
  "purpose": "ADDITIONAL_MATERIAL"
}

### 1.16 TENANT: загрузка вложения в MinIO
PUT {{tenantResponseInit.response.body.$.uploadUrl}}
Content-Type: image/png

< ../test-resources/image.png

### 1.17 TENANT: подтверждение загрузки вложения
# @name tenantResponseConfirm
POST {{baseUrl}}/api/storage/attachments/confirm
Authorization: Basic {{tenant1Basic}}
Content-Type: application/json

{
  "objectKey": "{{tenantResponseInit.response.body.$.objectKey}}"
}

### 1.18 TENANT: ответ по заявке
# @name tenantResponse
POST {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/tenant-response
Authorization: Basic {{tenant1Basic}}
Content-Type: application/json

{
  "agree": false,
  "comment": "Не согласен с полной суммой, но подтверждаю факт повреждения.",
  "attachmentIds": [
    {{tenantResponseConfirm.response.body.$.attachmentId}}
  ]
}

### 1.19 ADMIN: финальное решение - применить штраф
# @name supportPenaltyDecision
POST {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/support-decision
Authorization: Basic {{admin1Basic}}
Content-Type: application/json

{
  "applyPenalty": true,
  "penaltyAmount": 420.00,
  "penaltyCurrency": "USD",
  "note": "Штраф подтвержден после анализа материалов обеих сторон."
}

### 1.20 LANDLORD: закрытая заявка после штрафа
GET {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}
Authorization: Basic {{landlord1Basic}}

### 1.21 ADMIN: список заявок landlord1, включая закрытые
GET {{baseUrl}}/api/claims/landlord/{{landlord1Id}}?openOnly=false
Authorization: Basic {{admin1Basic}}

###############################################################################
### 2. Happy path: без доп. материалов и без штрафа
###############################################################################

### 2.1 LANDLORD2: создать вторую заявку без вложений
# @name createNoPenaltyClaim
POST {{baseUrl}}/api/claims
Authorization: Basic {{landlord2Basic}}
Content-Type: application/json

{
  "tenantId": {{tenant2Id}},
  "title": "Подозрение на мелкий ущерб",
  "description": "Есть сомнения по поводу повреждения, требуется проверка.",
  "claimedAmount": 100.00,
  "currency": "USD"
}

### 2.2 ADMIN2: intake без запроса доп. материалов
# @name intakeNoPenaltyClaim
POST {{baseUrl}}/api/claims/{{createNoPenaltyClaim.response.body.$.id}}/intake
Authorization: Basic {{admin2Basic}}
Content-Type: application/json

{
  "needMoreInfo": false,
  "comment": "Материалы достаточны для перехода к оценке."
}

### 2.3 ADMIN2: оценка - оснований для штрафа нет
# @name assessNoPenaltyClaim
POST {{baseUrl}}/api/claims/{{createNoPenaltyClaim.response.body.$.id}}/assessment
Authorization: Basic {{admin2Basic}}
Content-Type: application/json

{
  "assessmentAmount": 0.00,
  "assessmentNotes": "Повреждение не подтверждено, износ естественный.",
  "penaltyGrounds": false
}

### 2.4 LANDLORD2: просмотр закрытой без штрафа заявки
GET {{baseUrl}}/api/claims/{{createNoPenaltyClaim.response.body.$.id}}
Authorization: Basic {{landlord2Basic}}

### 2.5 LANDLORD2: список своих заявок без фильтра по открытым
GET {{baseUrl}}/api/claims/landlord/{{landlord2Id}}?openOnly=false
Authorization: Basic {{landlord2Basic}}

###############################################################################
### 3. Negative security checks после создания тестовых данных
###############################################################################

### Чужой landlord не может смотреть заявки landlord1: ожидаем 403 Forbidden
GET {{baseUrl}}/api/claims/landlord/{{landlord1Id}}?openOnly=false
Authorization: Basic {{landlord2Basic}}

### Чужой tenant не может ответить по claim landlord1/tenant1: ожидаем 403 Forbidden
POST {{baseUrl}}/api/claims/{{createPenaltyClaim.response.body.$.id}}/tenant-response
Authorization: Basic {{tenant2Basic}}
Content-Type: application/json

{
  "agree": false,
  "comment": "Это чужая заявка, ответ должен быть запрещён."
}

### LANDLORD не может сделать intake-решение: ожидаем 403 Forbidden
POST {{baseUrl}}/api/claims/{{createNoPenaltyClaim.response.body.$.id}}/intake
Authorization: Basic {{landlord2Basic}}
Content-Type: application/json

{
  "needMoreInfo": false,
  "comment": "Landlord must not pass admin-only operation."
}
