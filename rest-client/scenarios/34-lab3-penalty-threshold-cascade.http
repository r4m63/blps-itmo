POST {{baseUrl}}/api/claims/{{claimB34_id}}/support-decision
Authorization: Basic {{adminEmail}} {{adminPass}}
Content-Type: application/json

{ "applyPenalty": true, "penaltyAmount": 70, "penaltyCurrency": "USD", "simulateFailure": false, "resolutionNote": "B" }

