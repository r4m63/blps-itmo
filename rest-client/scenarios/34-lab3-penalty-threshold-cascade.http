POST {{baseUrl}}/api/claims
Authorization: Basic {{landlordEmail}} {{landlordPass}}
Content-Type: application/json

{ "tenantId": {{tenant34_id}}, "title": "Cascade B", "description": "Second in cascade.", "claimedAmount": 80, "currency": "USD" }

