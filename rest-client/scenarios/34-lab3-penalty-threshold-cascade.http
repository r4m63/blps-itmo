POST {{baseUrl}}/api/claims
Authorization: Basic {{landlordEmail}} {{landlordPass}}
Content-Type: application/json

{ "tenantId": {{tenant34_id}}, "title": "Cascade C", "description": "Third in cascade.", "claimedAmount": 100, "currency": "USD" }

