@baseUrl = http://localhost:21001
@landlord1Id = 1
@landlord2Id = 2
@tenant1Id = 4
@tenant2Id = 5
@admin1Id = 7
@admin2Id = 8
@landlord1Basic = bGFuZGxvcmQxQGV4YW1wbGUuY29tOnBhc3N3b3Jk
@landlord2Basic = bGFuZGxvcmQyQGV4YW1wbGUuY29tOnBhc3N3b3Jk
@tenant1Basic = dGVuYW50MUBleGFtcGxlLmNvbTpwYXNzd29yZA==
@tenant2Basic = dGVuYW50MkBleGFtcGxlLmNvbTpwYXNzd29yZA==
@admin1Basic = YWRtaW4xQGV4YW1wbGUuY29tOnBhc3N3b3Jk
@admin2Basic = YWRtaW4yQGV4YW1wbGUuY29tOnBhc3N3b3Jk

### Scenario 00: RBAC smoke checks
### Purpose:
### - verify 401 without auth
### - verify 403 for forbidden role
### - verify that valid credentials work on a permitted endpoint

### 00.1 No auth -> 401
GET {{baseUrl}}/api/claims/1

### 00.2 Tenant cannot create a claim -> 403
POST {{baseUrl}}/api/claims
Authorization: Basic {{tenant1Basic}}
Content-Type: application/json

{
  "tenantId": {{tenant1Id}},
  "title": "Forbidden create attempt",
  "description": "Tenant must not be allowed to create claims",
  "claimedAmount": 1.00,
  "currency": "USD"
}

### 00.3 Landlord can use storage presign/init endpoint -> 200
POST {{baseUrl}}/api/storage/presign
Authorization: Basic {{landlord1Basic}}
Content-Type: application/json

{
  "fileName": "smoke-check.png",
  "contentType": "image/png"
}

### 00.4 Admin cannot create a claim either -> 403
POST {{baseUrl}}/api/claims
Authorization: Basic {{admin1Basic}}
Content-Type: application/json

{
  "tenantId": {{tenant1Id}},
  "title": "Admin must not create claims",
  "description": "Only landlord is allowed to create claims",
  "claimedAmount": 10.00,
  "currency": "USD"
}
